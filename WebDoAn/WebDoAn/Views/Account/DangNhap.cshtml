@model DangNhapViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        @if (TempData["ThanhCong"] != null)
        {
            <div class="alert alert-success">@TempData["ThanhCong"]</div>
        }
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h4 class="mb-3">Đăng nhập hệ thống</h4>
                <form asp-action="DangNhap" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="TenDangNhap" class="form-label"></label>
                        <input asp-for="TenDangNhap" class="form-control" autofocus />
                        <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="MatKhau" class="form-label"></label>
                        <input asp-for="MatKhau" class="form-control" />
                        <span asp-validation-for="MatKhau" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
                </form>
                <p class="mt-3 mb-0 text-center">Chưa có tài khoản? <a asp-action="DangKy">Đăng ký</a></p>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
