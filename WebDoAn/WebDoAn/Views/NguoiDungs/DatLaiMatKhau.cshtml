@model WebDoAn.Models.NguoiDung
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}
<h2>Đặt lại mật khẩu</h2>
<p>Tài khoản: <strong>@Model.TenDangNhap</strong> (@Model.HoTen)</p>
<div class="row">
    <div class="col-md-5">
        <form asp-action="DatLaiMatKhau" method="post">
            <input type="hidden" name="id" value="@Model.MaNguoiDung" />
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label class="form-label">Mật khẩu mới</label>
                <input type="password" name="matKhauMoi" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Đặt lại</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>
